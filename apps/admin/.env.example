# Clerk - same application and instance as apps/web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Admins are promoted customers; point sign-up at the customer site
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://new.heavenlytravel.my/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Neon pooled connection string, same branch as apps/web for the same environment
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend, for booking emails from booking@heavenlytravel.my. Leave unset to
# print the emails to the terminal instead of sending them.
RESEND_API_KEY=re_...
# Where the links in those emails point. Default to production; set both on
# staging so a preview booking links to the preview.
SITE_URL=https://new.heavenlytravel.my
ADMIN_URL=https://manage.heavenlytravel.my
