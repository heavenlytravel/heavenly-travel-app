# CLERK - same application and instance as apps/web (Development locally and on Preview; Production on Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Admins are promoted customers; point sign-up at the customer site
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://new.heavenlytravel.my/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# NEONDB pooled connection string, same branch as apps/web for the same environment
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# RESEND (development key locally and on Preview; production key on Vercel Production)
# Leave RESEND_API_KEY unset to print the emails to the terminal instead.
# Outside Vercel Production the subject gets a "[Development] " prefix.
# Production sets only RESEND_API_KEY: the other four default to booking@
# and the production domains.
RESEND_API_KEY=re_...
EMAIL_FROM="Heavenly Travel <dev+booking@heavenlytravel.my>"
EMAIL_OPS_TO=you@heavenlytravel.my
SITE_URL=https://staging.heavenlytravel.my
ADMIN_URL=https://staging-manage.heavenlytravel.my
