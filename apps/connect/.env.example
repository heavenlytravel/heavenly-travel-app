# CLERK - same application and instance as apps/web and apps/manage
# (Development locally and on Preview; Production on Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# NEONDB pooled connection string, same branch as the other apps for the same environment
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# RESEND, as apps/manage: a driver accepting the last part of a trip sends
# the customer their driver. Leave RESEND_API_KEY unset to print the emails.
RESEND_API_KEY=re_...
EMAIL_FROM="Heavenly Travel <dev+booking@heavenlytravel.my>"
EMAIL_OPS_TO=you@heavenlytravel.my
SITE_URL=https://staging.heavenlytravel.my
ADMIN_URL=https://staging-manage.heavenlytravel.my
CONNECT_URL=https://staging-connect.heavenlytravel.my

# UPLOADTHING: the app of this database (dev app locally and on Preview),
# for the photos vendors add to their vehicles.
UPLOADTHING_TOKEN=
