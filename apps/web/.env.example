# CLERK (Development instance locally and on Preview; Production instance on Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# NEONDB pooled connection string (development branch locally and on Preview; production branch on Vercel Production)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# GOOGLE MAPS PLATFORM server key (Places API (New) + Routes API). Leave unset
# to run without Google: pickups come from the seeded zone districts and
# one-way trips cannot be priced.
GOOGLE_MAPS_SERVER_KEY=AIza...

# RESEND (development key locally and on Preview; production key on Vercel Production)
# Leave RESEND_API_KEY unset to print the emails to the terminal instead.
# Outside Vercel Production the subject gets a "[Development] " prefix.
# Production sets only RESEND_API_KEY: the other four default to booking@
# and the production domains.
RESEND_API_KEY=re_...
EMAIL_FROM="Heavenly Travel <dev+booking@heavenlytravel.my>"
EMAIL_OPS_TO=you@heavenlytravel.my
SITE_URL=https://staging.heavenlytravel.my
ADMIN_URL=https://staging-manage.heavenlytravel.my
