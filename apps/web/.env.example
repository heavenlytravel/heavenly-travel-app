# Clerk (Development instance locally and on Preview; Production instance on Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Neon pooled connection string (development branch locally and on Preview; production branch on Vercel Production)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Maps Platform server key (Places API (New) + Routes API). Leave unset
# to run without Google: pickups come from the seeded zone districts and
# one-way trips cannot be priced.
GOOGLE_MAPS_SERVER_KEY=AIza...

# Booking emails. Leave RESEND_API_KEY unset to print them to the terminal
# instead of sending. Outside Vercel Production the subject gets a
# "[Development] " prefix; use the dev key, the dev sender and your own inbox
# for the ops copies, so test bookings never reach the real ops inbox.
# Production leaves EMAIL_FROM and EMAIL_OPS_TO unset (booking@ for both).
RESEND_API_KEY=re_...
EMAIL_FROM="Heavenly Travel <dev+booking@heavenlytravel.my>"
EMAIL_OPS_TO=you@heavenlytravel.my
# Where the links in the emails point. Default to the production domains;
# set them locally and on the staging Preview.
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
