# Prisma CLI only (db:push, db:studio). Pooled Neon connection string.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon production branch. Used only by the *:prod scripts, after a typed confirmation.
DATABASE_URL_PRODUCTION=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon API, for the rehearsal on a throwaway copy of production and the
# backup branch that the writing *:prod scripts make.
# Key: Account settings > API keys. Project ID: the project's Settings page.
NEON_API_KEY=
NEON_PROJECT_ID=
