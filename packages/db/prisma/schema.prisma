generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Identity, mirrored from Clerk by the user.* webhook. Access to an area is
/// granted by the presence of the matching profile row, never by a role
/// column. Every signed-in user is a customer.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  /// Ours, not Clerk's. Asked for at the confirm step and kept for next time.
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminProfile   AdminProfile?
  driverProfile  DriverProfile?
  partnerProfile PartnerProfile?
  bookings       Booking[]
}

/// Staff access. `level` is one of the AdminLevel values in src/roles.ts.
model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stub. Real driver fields (licence, vehicle links) arrive with that feature.
model DriverProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(false)
  activeAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Stub. Real partner fields (company details) arrive with that feature.
model PartnerProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(false)
  activeAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Bookings. See docs/260923-car-with-driver.md and docs/260928-coach-charter.md. Money is
// integer sen; statuses and categories are strings validated against the
// const arrays in src/booking-status.ts.
// ---------------------------------------------------------------------------

/// A service area where drivers and vehicles are based: a named set of
/// districts. Never deleted, only deactivated.
model Zone {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  isActive   Boolean  @default(true)
  /// Applied to every price with a pickup in this zone. 1 means no change.
  multiplier Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  districts ZoneDistrict[]
  items     BookingItem[]
}

/// One district that belongs to a zone. `state` and `district` are spelled as
/// Google returns them in address components, so a geocode can be matched
/// without any translation.
model ZoneDistrict {
  id       String @id @default(cuid())
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state    String
  district String

  @@unique([state, district])
}

/// A bookable class of vehicle with driver, its rates and its rules. Never
/// deleted, only deactivated. A booking snapshots what it shows, so editing
/// or retiring a class never changes one.
model VehicleClass {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  /// "car-with-driver" | "coach-charter"
  category                String
  name                    String
  description             String
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  /// Information only ("from 15 seats"): fit is by maxPassengers alone.
  minPassengers           Int
  maxPassengers           Int
  luggage                 String
  baseFareSen             Int
  perKmSen                Int
  hourlyRateSen           Int
  minimumFareSen          Int
  /// A pickup must be at least this far in the future.
  minLeadHours            Int
  /// Customers may cancel until this long before pickup.
  cancellationCutoffHours Int
  /// Shortest hourly hire; never below the hourly floor in src/booking-rules.ts.
  minHourlyHours          Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tripItems TripItemDetails[]

  @@index([category, isActive])
}

/// An order: one or more items, each one product on one day. `status` is
/// derived from the items by `bookingStatusOf` and stored for filtering.
model Booking {
  id            String    @id @default(cuid())
  /// Short, random, human-readable: HT-7K3QZM. Used in emails and URLs.
  reference     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  status        String
  contactName   String
  contactPhone  String
  /// Sum of the live (not cancelled) items.
  priceTotalSen Int
  currency      String    @default("MYR")
  /// Earliest live item start, for sorting.
  startsAt      DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  /// "customer" | "admin"
  cancelledBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items BookingItem[]

  @@index([userId, createdAt])
  @@index([status, startsAt])
}

/// One product on one day inside a booking. Fulfilment happens here, because
/// a driver is assigned to a vehicle, not to a package. `product` says which
/// details table to read; exactly one details row exists per item.
model BookingItem {
  id                      String    @id @default(cuid())
  bookingId               String
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 within the booking; shown as "HT-7K3QZM item 2".
  position                Int
  /// "transportation"; later "attraction", "hotel", ...
  product                 String
  status                  String
  startsAt                DateTime
  /// startsAt plus the hours of an hourly hire; null for one-way.
  endsAt                  DateTime?
  /// Snapshot of the class rule at booking: the customer may cancel until
  /// this long before startsAt.
  cancellationCutoffHours Int
  zoneId                  String?
  zone                    Zone?     @relation(fields: [zoneId], references: [id])
  priceTotalSen           Int
  /// The receipt: mode, rates used, distance or hours, multiplier.
  priceBreakdown          Json
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tripDetails TripItemDetails?

  @@unique([bookingId, position])
  @@index([status, startsAt])
}

/// What a transportation item asked for, car or coach. Places are snapshots
/// of Google records (place id, address, lat, lng, state, district), never
/// queried by field, so they are JSON.
model TripItemDetails {
  id                   String       @id @default(cuid())
  itemId               String       @unique
  item                 BookingItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vehicleClassId       String
  vehicleClass         VehicleClass @relation(fields: [vehicleClassId], references: [id])
  /// Snapshots, so a renamed, moved or retired class never changes an old
  /// booking.
  vehicleClassName     String
  /// "car-with-driver" | "coach-charter"
  vehicleClassCategory String
  /// "oneway" | "hourly"
  mode                 String
  pickupPlace          Json
  dropoffPlace         Json?
  hours                Int?
  distanceKm           Float?
  passengers           Int
  /// Never asked for a coach.
  childSeats           Int          @default(0)
  flightNumber         String?
  notes                String?
}
