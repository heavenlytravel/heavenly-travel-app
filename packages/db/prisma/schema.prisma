generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Identity, mirrored from Clerk by the user.* webhook. Access to an area is
/// granted by the presence of the matching profile row, never by a role
/// column. Every signed-in user is a customer.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  /// Ours, not Clerk's. Asked for at the confirm step and kept for next time.
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminProfile  AdminProfile?
  driver        Driver?
  /// The vendors they own or work for, in Connect.
  vendorMembers VendorMember[]
  bookings      Booking[]
  bookingNotes  BookingNote[]
}

/// Staff access. `level` is one of the AdminLevel values and `teams` holds
/// AdminTeam values, both in src/roles.ts. What each team reaches is in
/// src/permissions.ts.
model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  teams     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// App-wide settings, one row with the id "app". See src/settings.ts.
model AppSetting {
  id          String   @id
  /// Off, every admin reaches every team screen and action. See
  /// src/permissions.ts.
  wallActive  Boolean  @default(false)
  /// The teams a SUPER admin gave a team rule, by permission, over the
  /// defaults in src/permissions.ts: { "bookings.fulfil": ["OPERATION"] }.
  /// A permission left out keeps its default. Read by ruleOverridesOf.
  accessRules Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

/// One admin, customer or system action, written in the same transaction
/// as the change it records. Never edited or deleted. `action`,
/// `actorKind` and `entityType` are the values in src/activity-actions.ts.
/// An item action logs against its booking.
model ActivityLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  /// The User who acted; null for the system. No relation, so an entry
  /// outlives its user unchanged.
  actorId         String?
  /// "admin" | "customer" | "guest" | "system"
  actorKind       String
  /// "booking.item.confirmed", "wall.switched", ...
  action          String
  /// "booking" | "state" | "district" | "vehicle-class" | "user" | "admin" | "setting"
  /// | "location" | "vehicle" | "driver"
  entityType      String
  entityId        String
  before          Json?
  after           Json?
  /// Whether a future customer page may show this entry. Staff names,
  /// internal notes and override reasons never reach a customer.
  customerVisible Boolean  @default(false)
  /// The locations whose history the entry belongs in besides its own
  /// record's: a vehicle's or a driver's location, both of them for a move.
  locationIds     String[] @default([])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([locationIds], type: Gin)
}

// ---------------------------------------------------------------------------
// Vendors. See docs/261028-fulfilment-vendors-and-connect.md. Every vehicle
// and driver belongs to one, Heavenly Travel included. Kinds, statuses,
// services and roles are strings checked against the const arrays in
// src/vendor-input.ts.
// ---------------------------------------------------------------------------

/// Whoever supplies a vehicle, a driver, a tour guide or more: a company, or
/// an individual whose only driver may be themself. Ours when SUPER switches `isOurs` on;
/// the code finds ours by it, never by the name.
model Vendor {
  id                String    @id @default(cuid())
  name              String
  /// "company" | "individual"
  kind              String
  /// Ours: no cost, no members, accepted for by Operation, and its vehicles
  /// reach the website. Only SUPER switches it.
  isOurs            Boolean   @default(false)
  /// "pending" | "active" | "refused" | "suspended"
  status            String
  /// The SSM number, or an individual's IC; empty when not given.
  registrationNo    String    @default("")
  contactName       String
  /// As src/phone.ts keeps it.
  contactPhone      String
  contactEmail      String
  address           String    @default("")
  /// Where we pay them: a bank from MALAYSIAN_BANKS, the account number in
  /// digits and the name on it; all empty until given. Screens show the
  /// number masked. See src/bank-input.ts.
  bankName          String    @default("")
  bankAccountNumber String    @default("")
  bankAccountName   String    @default("")
  /// What it offers: exactly one of VENDOR_SERVICES, chosen at sign-up and
  /// changed by staff alone (a list only because it once held several).
  /// It adds and is offered only what that supplies (suppliesIt).
  services          String[]  @default([])
  /// Old, dropped by the next schema change: an agent's invoice period,
  /// from when agents were vendors. Agents are `Business` rows now.
  invoicePeriod     String    @default("month")
  /// Why it was refused or suspended. Staff only.
  reviewNote        String?
  reviewedAt        DateTime?
  /// No relation, so the record outlives the reviewer.
  reviewedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// The locations it serves; each of its vehicles, drivers and guides is
  /// based at one.
  locations     Location[]
  members       VendorMember[]
  vehicles      Vehicle[]
  drivers       Driver[]
  guides        Guide[]
  offers        VendorOffer[]
  /// Old, dropped by the next schema change: as an agent.
  agentBookings Booking[]
  agentInvoices Invoice[]

  @@index([status])
}

/// What one vendor is asked for one booking: a vehicle, a driver or both,
/// for each of its trips, at an amount per trip and part (`TripPart`).
/// Ours gets one too, at no cost, accepted for by Operation. A part
/// declined, unanswered or backed out of is deleted and its trip reopened;
/// the offer keeps its status and the activity log the history. See
/// docs/261028-fulfilment-vendors-and-connect.md, "Acceptance".
model VendorOffer {
  id            String    @id @default(cuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        Vendor    @relation(fields: [vendorId], references: [id])
  /// "offered" | "accepted" | "declined" | "expired" | "withdrawn" | "released"
  status        String
  /// Unanswered by then, its parts are reopened.
  respondBy     DateTime
  /// "not-available" | "too-far" | "other", with `declineNote` for other.
  declineReason String?
  declineNote   String?
  /// No relations, so the record outlives the accounts.
  sentById      String?
  sentAt        DateTime  @default(now())
  answeredById  String?
  answeredAt    DateTime?
  /// Who accepted saw the timing warnings then, as they read.
  warningsSeen  String[]  @default([])

  parts TripPart[]

  @@index([bookingId])
  @@index([vendorId, status])
}

/// The vehicle, the driver or the tour guide of one trip, from one vendor's
/// offer, with what we owe that vendor for it. Accepted once its vendor
/// has, and, for a driver, once the driver has too. A guide has no account:
/// its vendor accepts for them, as for a vehicle.
model TripPart {
  id               String      @id @default(cuid())
  itemId           String
  item             BookingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  offerId          String
  offer            VendorOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// "vehicle" | "driver" | "guide"
  role             String
  /// Named by Operation, or by the vendor when asked for one; null until then.
  vehicleId        String?
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id])
  driverId         String?
  driver           Driver?     @relation(fields: [driverId], references: [id])
  guideId          String?
  guide            Guide?      @relation(fields: [guideId], references: [id])
  /// What we pay for this part of this trip: the vendor for a vehicle,
  /// the driver or the guide themselves for theirs; 0 for ours.
  costSen          Int         @default(0)
  /// A coach trip's driver only: the tip, out of the customer's total,
  /// that Operation sets for the driver; 0 otherwise.
  tipSen           Int         @default(0)
  vendorAcceptedAt DateTime?
  /// The driver's own acceptance; for a vehicle, unused.
  driverAcceptedAt DateTime?
  createdAt        DateTime    @default(now())

  @@unique([itemId, role])
  @@index([offerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([guideId])
}

/// An account that works for a vendor in Connect, its owner or its staff.
/// Ours has none: accepting for ours is `bookings.fulfil` in the admin.
model VendorMember {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "owner" | "staff"
  role      String
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Coverage. See docs/260930-coverage.md and
// docs/261015-locations-as-operation-areas.md. The rows are Malaysia's fixed
// states and districts, seeded from data/malaysia-districts.json and keyed
// by its codes; the boundaries stay in that file. Coverage is each
// location's zones.
// ---------------------------------------------------------------------------

/// One of the 13 states and 3 federal territories. `code` is ISO 3166-2,
/// "MY-10" for Selangor.
model State {
  code      String   @id
  name      String
  updatedAt DateTime @updatedAt

  districts District[]
  /// The locations that lie in it: a location ticks its states, and its
  /// zones are drawn within them.
  locations Location[]
}

/// One administrative district. `code` is the slug of its name, the key in
/// data/malaysia-districts.json.
/// Malaysia's districts, for placing an address: a booking records the
/// district its pickup fell in, and the zone maker draws the district
/// outlines under the zones. Coverage is the zones', not the districts'.
model District {
  code      String   @id
  name      String
  stateCode String
  state     State    @relation(fields: [stateCode], references: [code])
  updatedAt DateTime @updatedAt

  items BookingItem[]

  @@index([stateCode])
}

// ---------------------------------------------------------------------------
// Locations. See docs/261001-locations-and-pages.md and
// docs/261015-locations-as-operation-areas.md. A location is an operation
// area: the districts it owns, the classes it sells at its own rates, its
// zones and their rates, and its bookings, with a landing page and one page
// per product on the customer site. States and page keys are strings
// validated against the const arrays in src/location-input.ts.
// ---------------------------------------------------------------------------

/// A town, an island, a city or a state. Its state decides what the public
/// sees; its zones decide whether a pickup there is served.
model Location {
  id                  String    @id @default(cuid())
  /// The address of its pages: /langkawi. Locked the first time it goes live.
  slug                String    @unique
  name                String
  /// "draft" | "live" | "paused"
  state               String
  /// Set once, the first time the location goes live.
  wentLiveAt          DateTime?
  /// Its place among the home page's top choices; null when it is not one.
  topChoiceOrder      Int?
  /// The furthest extra road, in whole km: an end of a trip outside every
  /// zone further than this by road from its nearest zone is not priced.
  maxExtraKm          Int       @default(15)
  /// The free extra road, in whole km: each end outside every zone pays
  /// only for its road past this. 0 charges all of it.
  freeExtraKm         Int       @default(0)
  /// Whether trips may end in another location's zone, on the routes out
  /// this location prices to it. Off keeps every trip to its own zones.
  crossLocation       Boolean   @default(false)
  /// The odd-hours surcharge: a window as minutes of the local day (23:00
  /// is 1380, 07:00 is 420), and what it adds, a percentage of the price or
  /// a flat amount in sen, exactly one of the two. All null when there is
  /// none. See OddHours in src/rates-input.ts.
  oddHoursFromMinute  Int?
  oddHoursToMinute    Int?
  oddHoursPercent     Int?
  oddHoursFlatSen     Int?
  /// The weekend and holiday surcharge: the days of the week it applies
  /// on (0 is Sunday, 6 Saturday), the dates it also applies on
  /// ("2026-12-25"), and what it adds, a percentage or a flat amount in
  /// sen, exactly one of the two. The amounts null when there is none.
  /// See WeekendSurcharge in src/rates-input.ts.
  weekendDays         Int[]     @default([])
  holidayDates        String[]  @default([])
  weekendPercent      Int?
  weekendFlatSen      Int?
  /// Minutes a vehicle or driver is kept free after a job, on top of the
  /// drive to the next: roads differ by place. 0 turns it off.
  safetyBufferMinutes Int       @default(15)
  /// What a stop added to a trip suggests for its driver's pay: this much
  /// per extra km by road, plus `stopFeeSen` a stop. Entered by Operation;
  /// null when not entered, and staff type the pay. See src/stop-pay.ts.
  driverPayPerKmSen   Int?
  stopFeeSen          Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pages            LocationPage[]
  addresses        LocationAddress[]
  /// The states it lies in. Its saved addresses are in them, and its zones
  /// are drawn within them.
  states           State[]
  offerings        LocationVehicleClass[]
  zones            Zone[]
  zoneRates        ZoneRate[]
  /// The rate per extra hour of its hourly price list; the packages are its zones'.
  hourlyExtraRates HourlyExtraRate[]
  /// The tour guide's price list, a row per language.
  guideRates       GuideRate[]
  items            BookingItem[]
  vehicles         Vehicle[]
  drivers          Driver[]
  guides           Guide[]
  /// The vendors that serve it.
  vendors          Vendor[]

  @@index([state])
}

/// A class a location sells, at the location's rates and under its rules.
/// Langkawi's Sedan and Penang's Sedan are one catalogue class with two
/// offerings. Off hides the class from the location's options page; a
/// booking keeps its snapshot. The rules' defaults are for the schema push
/// only: db:migrate-offering-rules copies each class's old rules onto its
/// offerings once, and every offering written since sets all three. See
/// docs/261018-location-work-and-class-catalogue.md.
model LocationVehicleClass {
  id                      String       @id @default(cuid())
  locationId              String
  location                Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vehicleClassId          String
  vehicleClass            VehicleClass @relation(fields: [vehicleClassId], references: [id])
  isActive                Boolean      @default(true)
  /// The rate per extra km: the road past a zone's edge.
  perKmSen                Int
  /// Unused since the hourly grid (docs/261102-booking-ops.md); dropped
  /// with `minHourlyHours` once no deployed code reads them.
  hourlyRateSen           Int          @default(0)
  /// A pickup must be at least this far in the future.
  minLeadHours            Int          @default(0)
  /// Customers may cancel until this long before pickup.
  cancellationCutoffHours Int          @default(0)
  /// Unused since the hourly grid; see `hourlyRateSen`.
  minHourlyHours          Int          @default(0)
  /// What a customer pays to choose the model they ride in, among the
  /// class's models with a vehicle in service here: a percentage of the
  /// trip's price or a flat amount in sen, exactly one of the two. Both null
  /// when customers here cannot choose. See modelChoiceOf in
  /// src/offering-input.ts.
  modelChoicePercent      Int?
  modelChoiceFlatSen      Int?
  /// Where the class stands among its category's here, on the console and
  /// to the customer: 1, 2, 3 once the location's list is first ordered, 0
  /// for every one before, which leaves the catalogue's order. See
  /// byClassOrder in src/offering-input.ts.
  sortOrder               Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([locationId, vehicleClassId])
  @@index([vehicleClassId])
}

/// A line on a location's price list: an area the admin drew on a map, or a
/// circle around a place. A zone may lie outside the location's districts:
/// an outstation destination is a zone too. Coverage is the district's.
model Zone {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  /// One closed ring of [lng, lat], as src/geo.ts reads it.
  shape      Json
  /// `{ placeId, label, radiusM }` when drawn as a circle around a place,
  /// so the editor can show and redo it; null for a drawn polygon.
  drawnFrom  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// The hourly packages a pickup in it is sold, with their prices.
  hourlyPackages HourlyPackage[]
  ratesFrom      ZoneRate[]      @relation("from")
  ratesTo        ZoneRate[]      @relation("to")

  @@index([locationId, sortOrder])
}

/// One cell of a location's rate grid: the fixed price of a class between
/// two zones. Read both ways: (from, to), then (to, from). `from` is a zone
/// of the location; `to` may be another location's, for a route out of it,
/// such as Kuala Lumpur's to KLIA, which is Selangor's. Two locations may
/// each price the same two zones, so the location is part of the key.
model ZoneRate {
  id             String       @id @default(cuid())
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fromZoneId     String
  fromZone       Zone         @relation("from", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZoneId       String
  toZone         Zone         @relation("to", fields: [toZoneId], references: [id], onDelete: Cascade)
  vehicleClassId String
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id])
  priceSen       Int
  updatedAt      DateTime     @updatedAt

  @@unique([locationId, fromZoneId, toZoneId, vehicleClassId])
  @@index([vehicleClassId])
  @@index([fromZoneId])
  @@index([toZoneId])
}

/// A package a pickup in a zone is sold: 4, 8 or 12 hours
/// (HOURLY_PACKAGES), the hours it covers from there, and its price per
/// class. A package with no price for a class is not sold in that class.
/// See docs/261102-booking-ops.md, "Hourly rate grid".
model HourlyPackage {
  id            String   @id @default(cuid())
  zoneId        String
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// 4, 8 or 12: what the package is called.
  hours         Int
  /// The hours it covers from this zone, the sheet's "max hour usage":
  /// usually `hours`, 5 for Langkawi's port cruise 4-hour package.
  includedHours Int
  updatedAt     DateTime @updatedAt

  rates HourlyRate[]

  @@unique([zoneId, hours])
}

/// One cell of the hourly price list: a package's price in one class.
model HourlyRate {
  id             String        @id @default(cuid())
  packageId      String
  package        HourlyPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  vehicleClassId String
  vehicleClass   VehicleClass  @relation(fields: [vehicleClassId], references: [id])
  priceSen       Int
  updatedAt      DateTime      @updatedAt

  @@unique([packageId, vehicleClassId])
  @@index([vehicleClassId])
}

/// What an hour past a package costs at a location, in one class: one rate
/// per package size, the same from every zone.
model HourlyExtraRate {
  id             String       @id @default(cuid())
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// 4, 8 or 12.
  packageHours   Int
  vehicleClassId String
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id])
  priceSen       Int
  updatedAt      DateTime     @updatedAt

  @@unique([locationId, packageHours, vehicleClassId])
  @@index([vehicleClassId])
}

/// A location's tour guide price for one language, per trip: one-way, a
/// 4, 8 or 12-hour hire, and each hour past it. The website sells the
/// language on a trip only while `isActive` and the trip's price is set.
/// See docs/261103-tour-guide.md, "Guide rates".
model GuideRate {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// From GUIDE_LANGUAGES.
  language     String
  /// Where the language comes in the location's list, from 0: the order
  /// customers see the languages on sale in. Ops sets it on Guide Rates.
  position     Int      @default(0)
  isActive     Boolean  @default(false)
  oneWaySen    Int?
  hours4Sen    Int?
  hours8Sen    Int?
  hours12Sen   Int?
  extraHourSen Int?
  updatedAt    DateTime @updatedAt

  @@unique([locationId, language])
}

/// One page of a location in one locale: its main page, a section's own
/// page, or a page under a section, by its slug. Marketing edits `draft`;
/// the public reads `published`. See docs/261025-marketing-pages.md.
model LocationPage {
  id               String    @id @default(cuid())
  locationId       String
  location         Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// "landing" or a section's key: "car-with-driver", "popular-places", ...
  /// See LOCATION_PAGES in src/location-page-input.ts.
  page             String
  /// "" for the main page and a section's own page; else the page's slug
  /// under its section: a vehicle class's ("sedan"), or one Marketing gave
  /// a page it added ("eagle-square").
  slug             String    @default("")
  locale           String    @default("en")
  /// Its place among the pages Marketing added to its section, from 0.
  position         Int       @default(0)
  /// Whether the page is published: true from a publish until it is
  /// unpublished. Not whether the product can be booked there: that is the
  /// location's zones.
  isOn             Boolean   @default(false)
  /// The working copy.
  draft            Json
  /// What the public sees; kept through an unpublish, null until the first
  /// publish.
  published        Json?
  publishedAt      DateTime?
  /// Set once, at the first publish: the date a post shows, and from then
  /// its slug is locked.
  firstPublishedAt DateTime?
  /// When the draft or the published copy last changed. An unpublish leaves
  /// it, so it names the content a form was opened with: a save over
  /// someone else's change is refused by it.
  updatedAt        DateTime  @updatedAt

  @@unique([locationId, page, slug, locale])
}

/// A page of the whole site in one locale: the home page's content, about
/// us, contact us and the legal pages. As a location's page: Marketing
/// edits `draft`, the public reads `published` while `isOn`. `page` is
/// one of SITE_PAGES in src/site-page-input.ts. See
/// docs/261025-marketing-pages.md, "Site pages".
model SitePage {
  id               String    @id @default(cuid())
  page             String
  locale           String    @default("en")
  isOn             Boolean   @default(false)
  draft            Json
  published        Json?
  publishedAt      DateTime?
  firstPublishedAt DateTime?
  /// As LocationPage.updatedAt: names the content a form was opened with.
  updatedAt        DateTime  @updatedAt

  @@unique([page, locale])
}

/// A place most customers go to in a location: "Kuah Jetty". The drop-off
/// offers the list before anything is typed. An exact spot, never an area.
model LocationAddress {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// What the customer reads.
  name       String
  /// An exact Google place, as `Place`.
  place      Json
  /// Its order in the list, from 0.
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Bookings. See docs/260923-car-with-driver.md and docs/260928-coach-charter.md. Money is
// integer sen; statuses and categories are strings validated against the
// const arrays in src/booking-status.ts.
// ---------------------------------------------------------------------------

/// The catalogue: a class of vehicle with driver, what it is, its seats,
/// its luggage and its picture. A location sells it through a
/// `LocationVehicleClass`, which carries the rates and the rules. Never
/// deleted, only deactivated. A booking snapshots what it shows, so
/// editing or retiring a class never changes one.
model VehicleClass {
  id            String   @id @default(cuid())
  slug          String   @unique
  /// "car-with-driver" | "coach-charter"
  category      String
  name          String
  description   String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Information only ("from 15 seats"): fit is by maxPassengers alone.
  minPassengers Int
  maxPassengers Int
  luggage       String
  /// Its pictures, files on UploadThing (src/images.ts), in order, the
  /// first its cover: the same at every location; none for none.
  imageUrls     String[] @default([])
  /// Its one picture before it had several: copied into `imageUrls` by
  /// db:set-class-pictures and read by nothing since. Dropped at the next
  /// schema change.
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tripItems        TripItemDetails[]
  offerings        LocationVehicleClass[]
  zoneRates        ZoneRate[]
  hourlyRates      HourlyRate[]
  hourlyExtraRates HourlyExtraRate[]
  models           VehicleModel[]
  /// The drivers who may drive it.
  drivers          Driver[]

  @@index([category, isActive])
}

/// A model of a class, the Toyota Alphard in MPV VIP: what a vehicle is,
/// by brand and name, one catalogue for every location. The vehicle form
/// adds one the first time a vehicle of it is entered, and suggests the
/// ones there are. A location's class has the models of its vehicles in
/// service, and a customer may choose one at the charge on the class's
/// offering. See docs/261019-vehicles-and-drivers.md.
model VehicleModel {
  id             String       @id @default(cuid())
  vehicleClassId String
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id])
  /// "Toyota". Empty only on a model named before brands were kept, until
  /// db:set-class-list splits its name.
  brand          String       @default("")
  /// The model alone: "Alphard". The screens show "Toyota Alphard".
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vehicles  Vehicle[]
  tripItems TripItemDetails[]

  @@unique([vehicleClassId, brand, name])
}

/// One of our vehicles, based at a location. The expiry dates of its documents
/// are dates, null where one does not apply. Its photos are for our team;
/// the website does not show them. Out of service, it keeps its
/// history. See docs/261019-vehicles-and-drivers.md.
model Vehicle {
  id                  String       @id @default(cuid())
  /// Whose it is.
  vendorId            String
  vendor              Vendor       @relation(fields: [vendorId], references: [id])
  /// In capitals without spaces: "VLE1234".
  plate               String       @unique
  vehicleModelId      String
  vehicleModel        VehicleModel @relation(fields: [vehicleModelId], references: [id])
  locationId          String
  location            Location     @relation(fields: [locationId], references: [id])
  colour              String
  /// The year it was made.
  year                Int?
  isActive            Boolean      @default(true)
  roadTaxExpiresOn    DateTime?    @db.Date
  insuranceExpiresOn  DateTime?    @db.Date
  /// The PUSPAKOM inspection.
  inspectionExpiresOn DateTime?    @db.Date
  /// The operating permit: APAD's in Peninsular Malaysia.
  permitExpiresOn     DateTime?    @db.Date
  notes               String       @default("")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  photos VehiclePhoto[]
  parts  TripPart[]

  @@index([locationId, isActive])
  @@index([vehicleModelId])
  @@index([vendorId])
}

/// One photo of a vehicle, in its order; the first is the vehicle's cover.
model VehiclePhoto {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// A file on UploadThing (src/images.ts).
  url       String
  /// "Interior": its alt text beside the model's name; empty for the name.
  caption   String  @default("")
  sortOrder Int

  @@index([vehicleId, sortOrder])
}

/// A vendor's driver, ours or another's, based at a location. A driver
/// exists before they have an account; it is linked by `email` when an
/// account with it exists or is made (src/sync.ts), and opens Connect. See
/// docs/261019-vehicles-and-drivers.md and
/// docs/261028-fulfilment-vendors-and-connect.md.
model Driver {
  id                String         @id @default(cuid())
  /// Whose driver they are.
  vendorId          String
  vendor            Vendor         @relation(fields: [vendorId], references: [id])
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Lowercase; what links their account. Null until known.
  email             String?        @unique
  locationId        String
  location          Location       @relation(fields: [locationId], references: [id])
  name              String
  /// Their WhatsApp, as src/phone.ts keeps it.
  phone             String
  /// The classes they may drive: a coach driver is not a sedan driver.
  vehicleClasses    VehicleClass[]
  licenceExpiresOn  DateTime?      @db.Date
  /// The PSV vocational licence, to drive paying passengers.
  psvExpiresOn      DateTime?      @db.Date
  isActive          Boolean        @default(true)
  notes             String         @default("")
  /// Their pay goes to their vendor's account, not one of their own: the
  /// bank fields below stay empty. See src/bank-input.ts.
  paidToVendor      Boolean        @default(false)
  /// Where we pay them: a bank from MALAYSIAN_BANKS, the account number in
  /// digits and the name on it; all empty until given. Screens show the
  /// number masked. See src/bank-input.ts.
  bankName          String         @default("")
  bankAccountNumber String         @default("")
  bankAccountName   String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// The trips they were named for.
  parts TripPart[]

  @@index([locationId, isActive])
  @@index([vendorId])
}

/// A vendor's tour guide, ours or another's, based at a location. No
/// account: the vendor accepts a trip for them and names them, as for a
/// vehicle, and the driver reports the day. Out of service, they keep their
/// history. See docs/261103-tour-guide.md.
model Guide {
  id                String    @id @default(cuid())
  /// Whose guide they are.
  vendorId          String
  vendor            Vendor    @relation(fields: [vendorId], references: [id])
  locationId        String
  location          Location  @relation(fields: [locationId], references: [id])
  name              String
  /// Their WhatsApp, as src/phone.ts keeps it.
  phone             String
  /// Lowercase; the Connect account that sees this as its own guide
  /// profile, a vendor's owner or driver who guides too. Gives no account
  /// and no access. Null when they have none.
  email             String?   @unique
  /// The languages they guide in, as typed: "English", "Mandarin".
  languages         String[]  @default([])
  /// The tourist guide licence from MOTAC.
  motacExpiresOn    DateTime? @db.Date
  isActive          Boolean   @default(true)
  notes             String    @default("")
  /// Their pay goes to their vendor's account, not one of their own: the
  /// bank fields below stay empty. See src/bank-input.ts.
  paidToVendor      Boolean   @default(false)
  /// Where we pay them: a bank from MALAYSIAN_BANKS, the account number in
  /// digits and the name on it; all empty until given. Screens show the
  /// number masked. See src/bank-input.ts.
  bankName          String    @default("")
  bankAccountNumber String    @default("")
  bankAccountName   String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// The trips they were named for.
  parts TripPart[]

  @@index([locationId, isActive])
  @@index([vendorId])
}

/// One tap of a trip's driver on the day, or Operation's on their
/// behalf: on the way, arrived, passenger on board, dropped off, no-show,
/// a problem. Never edited or deleted. Dropped off and no-show complete the
/// trip. Made with an id from the phone, so a tap sent again never counts
/// twice. See docs/261028-fulfilment-vendors-and-connect.md, "On the day".
model TripEvent {
  id        String      @id @default(cuid())
  itemId    String
  item      BookingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// The driver it is about; no relation, so it outlives the driver's row.
  driverId  String?
  /// The account that tapped: the driver's, or the admin's for them.
  actorId   String?
  /// TRIP_EVENT_KINDS
  kind      String
  /// When it happened, by the phone's clock.
  at        DateTime
  note      String?
  /// Made on the phone; a retry never counts twice.
  clientId  String      @unique
  createdAt DateTime    @default(now())

  @@index([itemId, at])
}

/// A business we sell to on account. Only agents for now; corporates and
/// Biz members come with Biz (docs/261105-biz-business-accounts.md). Its
/// bookings are billed to it, per booking or, on credit terms, by the
/// month-end run. See src/businesses.ts and src/billing.ts.
model Business {
  id             String   @id @default(cuid())
  /// BUSINESS_KINDS: "agent"
  kind           String
  name           String
  /// "active" | "inactive": inactive takes no new bookings, is still billed.
  status         String   @default("active")
  /// The SSM number; empty when not given.
  registrationNo String   @default("")
  contactName    String
  /// As src/phone.ts keeps it.
  contactPhone   String
  contactEmail   String
  address        String   @default("")
  /// PAYMENT_TERMS: "none", billed per booking when confirmed, or credit:
  /// "month" or "half-month", billed by the month-end run.
  paymentTerms   String
  /// Days from an invoice's issue to its due date.
  daysToPay      Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]
  invoices Invoice[]

  @@index([kind, status])
}

/// An order: one or more items, each one product on one day. `status` is
/// derived from the items by `bookingStatusOf` and stored for filtering.
/// The contact fields are copies, so a later profile change never rewrites
/// a booking. A booking made by a signed-out visitor, or entered by staff
/// for a customer with no account, has no user; it joins an account when
/// one is first created with its email. See docs/261008-guest-booking.md
/// and docs/261108-billing-and-revisions.md.
model Booking {
  id                  String    @id @default(cuid())
  /// The booking number, HTB-1042: its id everywhere, one running count by
  /// `BookingNumberCounter` ("booking"), given when it is made. Null only
  /// on rows from before it, until db:set-billing numbers them; required
  /// by the next schema change. See src/booking-number.ts.
  number              Int?      @unique
  /// Old: the random reference (HT-7K3QZM), written only by the code
  /// before booking numbers. Dropped by the next schema change.
  reference           String?   @unique
  /// Old, dropped by the next schema change: the quotation number (never
  /// given), the invoice before `InvoiceLine`, its line on an agent's, the
  /// agent as a vendor and the invoice number before `invoiceId`.
  quoteNumber         Int?      @unique
  invoiceId           String?
  invoice             Invoice?  @relation("OldBookingInvoice", fields: [invoiceId], references: [id])
  invoiceLine         Int?
  agentId             String?
  agent               Vendor?   @relation(fields: [agentId], references: [id])
  invoiceNumber       Int?
  /// The business it was sold through, billed for it: an agent. Null for a
  /// customer of ours, billed in the booking's contact's name.
  businessId          String?
  business            Business? @relation(fields: [businessId], references: [id])
  /// An invoice of the old system or of before this one, as staff typed it
  /// (HT1223, HTI-1295-03): for reference, not unique. A booking with one
  /// is billed outside the system: no invoice is ever made for it here.
  legacyInvoiceNumber String?
  /// The account the booking shows under; null for a guest.
  userId              String?
  user                User?     @relation(fields: [userId], references: [id])
  status              String
  contactName         String
  contactPhone        String
  /// Where the customer's emails go. Required of every new booking since
  /// docs/261008-guest-booking.md; null on older rows. Read through
  /// `customerEmailOf`, which falls back to the account's email for
  /// bookings made before this column existed.
  contactEmail        String?
  /// The address a website booking came from. Only for the rate limit;
  /// never shown. Null for bookings entered by staff.
  createdIp           String?
  /// What the customer pays now: the live items, and every charge (a
  /// cancelled trip's fee included). Rev by rev in `revisions`.
  priceTotalSen       Int
  currency            String    @default("MYR")
  /// Earliest live item start, for sorting, and the first pick-up the
  /// month-end run goes by.
  startsAt            DateTime
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  /// "customer" | "admin"
  cancelledBy         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items        BookingItem[]
  notes        BookingNote[]
  offers       VendorOffer[]
  revisions    BookingRevision[]
  charges      BookingCharge[]
  invoiceLines InvoiceLine[]
  payments     Payment[]

  @@unique([invoiceId, invoiceLine])
  @@index([agentId, startsAt])
  @@index([businessId, startsAt])
  @@index([userId, createdAt])
  @@index([status, startsAt])
  @@index([contactEmail, createdAt])
  @@index([createdIp, createdAt])
  @@index([createdAt])
}

/// One state of a booking, append only: Rev 1 is the booking as made, and
/// every change to what we deliver, charge or pay writes the next. See
/// src/revisions.ts.
model BookingRevision {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 within the booking.
  number      Int
  /// REVISION_KINDS: "booked" | "change" | "add-trip" | "stop" | "add-on"
  /// | "late-charge" | "discount" | "correction" | "cancel"
  kind        String
  /// Why, as staff gave it. Staff only.
  reason      String?
  /// The customer's line: "Stop at Pantai Cenang added".
  summary     String
  /// The booking as it stood: `RevisionSnapshot` in src/revisions.ts.
  snapshot    Json
  /// What the rates quoted for it: the live trips' quotes and the charges.
  quotedSen   Int
  /// What the customer pays at this revision.
  chargedSen  Int
  /// No relation, so the record outlives the account; null for the system.
  createdById String?
  createdAt   DateTime @default(now())

  invoiceLines InvoiceLine[]
  payLines     ItemPayLine[]
  charges      BookingCharge[]

  @@unique([bookingId, number])
}

/// Something charged on a booking besides its trips' prices: an add-on, a
/// late charge (toll, parking, overtime), a cancelled trip's fee. Never
/// edited: a wrong one is taken off by a correction, a charge of minus
/// the same.
model BookingCharge {
  id         String          @id @default(cuid())
  bookingId  String
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// The trip it is for; null for the booking as a whole.
  itemId     String?
  item       BookingItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  revisionId String
  revision   BookingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// The customer's words: "Parking at KLIA", "Cancellation fee".
  label      String
  amountSen  Int
  createdAt  DateTime        @default(now())

  @@index([bookingId])
}

/// An addition to what we pay for a role of a trip, from a revision:
/// "+RM40 stop at Pantai Cenang". The role's pay is its part's `costSen`
/// plus these, whoever holds the role, so a new driver keeps the stop's
/// pay. See src/stop-pay.ts.
model ItemPayLine {
  id         String          @id @default(cuid())
  itemId     String
  item       BookingItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// "vehicle" | "driver" | "guide"
  role       String
  revisionId String
  revision   BookingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  amountSen  Int
  reason     String
  createdAt  DateTime        @default(now())

  @@index([itemId, role])
}

/// An invoice or a credit note, numbered per type when issued: HTI-0001,
/// HTC-0001. Its amounts are its lines', each from a booking: its first
/// bill, or a revision's difference. Issued, it never changes; a wrong one
/// is voided with a reason. See src/billing.ts.
///
/// The old invoices (one per booking, or an agent's per period with each
/// booking a line) are rows of this table too, with `agentId`,
/// `paymentStatus` and `bookings`; db:set-billing moves their numbers into
/// `Booking.legacyInvoiceNumber` and deletes them, and the next schema
/// change drops those columns.
model Invoice {
  id           String    @id @default(cuid())
  /// INVOICE_TYPES: "invoice" | "credit"
  type         String    @default("invoice")
  /// Per type, from its counter: an invoice when opened (a booking
  /// confirmed, an agent's period's first booking), a credit note when
  /// issued. Null only on the old system's rows.
  number       Int?
  /// INVOICE_STATUSES: "open" | "issued" | "void"
  status       String    @default("issued")
  /// The business billed; null for a customer of ours.
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id])
  /// Who it is billed to, as at issue: `BillTo` in src/billing.ts.
  billTo       Json      @default("{}")
  /// A month-end run's period, its first and last day; null on a single
  /// booking's invoice.
  periodStart  DateTime? @db.Date
  periodEnd    DateTime? @db.Date
  /// A credit note's invoice.
  creditsId    String?
  credits      Invoice?  @relation("CreditNote", fields: [creditsId], references: [id])
  creditNotes  Invoice[] @relation("CreditNote")
  /// The invoice a void one was replaced by.
  replacedById String?   @unique
  replacedBy   Invoice?  @relation("Replacement", fields: [replacedById], references: [id])
  replaces     Invoice?  @relation("Replacement")
  /// Its lines' sum, frozen at issue; negative on a credit note.
  totalSen     Int       @default(0)
  issuedAt     DateTime?
  dueAt        DateTime?
  voidedAt     DateTime?
  voidReason   String?
  /// No relations, so the record outlives the accounts.
  createdById  String?
  issuedById   String?
  voidedById   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  /// Old, dropped by the next schema change.
  agentId       String?
  agent         Vendor?   @relation(fields: [agentId], references: [id])
  paymentStatus String    @default("pending")
  bookings      Booking[] @relation("OldBookingInvoice")

  @@unique([type, number])
  @@unique([agentId, periodStart])
  @@index([businessId, periodStart])
  @@index([status, issuedAt])
  @@index([creditsId])
}

/// What one booking adds to an invoice or a credit note. On an open
/// invoice, what the booking has not been billed yet, kept up with each
/// change until it is issued. See src/billing.ts.
model InvoiceLine {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id])
  /// The revision it bills up to; null on a draft's line.
  revisionId  String?
  revision    BookingRevision? @relation(fields: [revisionId], references: [id])
  /// "HTB-1042 Rev 3: Stop at Pantai Cenang added".
  description String           @default("")
  amountSen   Int              @default(0)
  /// Old: the month-end draft's tick, unused; dropped by the next schema change.
  ticked      Boolean          @default(true)

  @@unique([invoiceId, bookingId])
  @@index([bookingId])
}

/// Money in (positive) or a refund out (negative), against an invoice or
/// a credit note, for one booking on it. Reversed with a reason, never
/// deleted.
model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  /// The booking it pays or refunds: the document's one booking, or one of
  /// an agent's month-end invoice's, so each booking reads its own.
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id])
  amountSen     Int
  /// PAYMENT_METHODS: "transfer" | "cash" | "cash-to-driver" | "card" | "cheque" | "other"
  method        String
  /// The day it came in or went out.
  paidAt        DateTime  @db.Date
  /// A bank reference, a receipt, who handed it in.
  note          String?
  recordedById  String?
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?
  createdAt     DateTime  @default(now())

  @@index([invoiceId])
  @@index([bookingId])
}

/// The last number given, per kind: "booking" (HTB), "invoice" (HTI),
/// "credit" (HTC), and "quote" (HTQ) unused until quotations. One running
/// count that never starts again. Taken one at a time inside the
/// transaction that gives it (`nextBookingNumber`), so two never share one
/// and a rolled-back one leaves no gap. Set by `db:set-billing`.
model BookingNumberCounter {
  kind String @id
  last Int
}

/// A note staff keep on a booking. Never shown to the customer, never
/// edited or deleted: a wrong note is followed by a correcting one. The
/// author is kept as an id that survives the user's deletion.
model BookingNote {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// One product on one day inside a booking. Fulfilment happens here, because
/// a driver is assigned to a vehicle, not to a package. `product` says which
/// details table to read; exactly one details row exists per item.
model BookingItem {
  id                      String    @id @default(cuid())
  bookingId               String
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 within the booking; shown as "HTB-1042 trip 2".
  position                Int
  /// "transportation"; later "attraction", "hotel", ...
  product                 String
  status                  String
  startsAt                DateTime
  /// startsAt plus the hours of an hourly hire; null for one-way.
  endsAt                  DateTime?
  /// Snapshot of the class rule at booking: the customer may cancel until
  /// this long before startsAt.
  cancellationCutoffHours Int
  /// The district the pickup was placed in at booking, for the record.
  districtCode            String?
  district                District? @relation(fields: [districtCode], references: [code])
  /// The location whose zone the pickup fell in at booking, whose rates
  /// priced the item. A zone redrawn later does not rewrite it. Null on
  /// items booked before locations priced trips.
  locationId              String?
  location                Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// The override when one is set, otherwise the receipt's total.
  priceTotalSen           Int
  /// The receipt: mode, rates used, distance or hours, the route's fixed
  /// rate or the surcharge. Never changed by an override, so the quoted
  /// price stays on record.
  priceBreakdown          Json
  /// An agreed price in place of the receipt's, with why. Both null when
  /// the rates' price stands. Staff only; the reason never reaches a
  /// customer.
  priceOverrideSen        Int?
  priceOverrideReason     String?
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tripDetails TripItemDetails?
  /// Who does it: the vehicle and the driver, each from a vendor's offer.
  parts       TripPart[]
  /// What its driver reported on the day, in order.
  events      TripEvent[]
  /// Its charges besides its price: add-ons, late charges, its fee.
  charges     BookingCharge[]
  /// What revisions added to the pay of its vehicle, driver or guide.
  payLines    ItemPayLine[]

  @@unique([bookingId, position])
  @@index([status, startsAt])
  @@index([locationId, startsAt])
}

/// What a transportation item asked for, car or coach. Places are snapshots
/// of Google records (place id, address, lat, lng, state, district), never
/// queried by field, so they are JSON.
model TripItemDetails {
  id                   String        @id @default(cuid())
  itemId               String        @unique
  item                 BookingItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vehicleClassId       String
  vehicleClass         VehicleClass  @relation(fields: [vehicleClassId], references: [id])
  /// Snapshots, so a renamed, moved or retired class never changes an old
  /// booking.
  vehicleClassName     String
  /// One-way: Google's drive, pin to pin, in whole minutes without
  /// traffic, from the route pricing asked for; the trip ends at its pickup
  /// plus this. Null for hourly, and on trips booked before it was kept,
  /// whose end is estimated from their distance.
  driveMinutes         Int?
  /// The model the customer chose, which the receipt charges for, and its
  /// name as a snapshot: "Toyota Alphard". Both null when any model of the
  /// class will do.
  vehicleModelId       String?
  vehicleModel         VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  vehicleModelName     String?
  /// "car-with-driver" | "coach-charter"
  vehicleClassCategory String
  /// "oneway" | "hourly"
  mode                 String
  pickupPlace          Json
  /// The places it stops at on the way, in order, each a `TripStop` of
  /// src/stops.ts: the place, the wait, what its revision quoted. Still one
  /// trip: A to C by B. Empty for none.
  stops                Json          @default("[]")
  dropoffPlace         Json?
  hours                Int?
  distanceKm           Float?
  passengers           Int
  /// Never asked for a coach.
  childSeats           Int           @default(0)
  /// The tour guide's language the customer paid for, from GUIDE_LANGUAGES:
  /// a guide speaking it is assigned beside the vehicle and the driver, and
  /// the receipt charges the location's guide rate. Null without a guide.
  guideLanguage        String?
  /// A language the customer asked for that is not on sale, free: Operation
  /// looks for a guide and, when one is found, amends the trip. Null when
  /// none was asked.
  guideRequest         String?
  flightNumber         String?
  notes                String?

  @@index([vehicleModelId])
}
